<launch>
  <!-- Remap these as needed to your camera topics -->
  <arg name="bag_file" default="/app/realsense_camera_feed/brown_door/brown_door_opening_inward_with_other_side_visible_but_with_lot_of_noise_night.bag"/>

  <!-- Debug toggle: run with debug:=true to enable VS Code attach -->
  <arg name="debug" default="false"/>
  <!-- Unique debug ports per node to avoid conflicts -->
  <arg name="debug_port_realsense_bag_bridge" default="5677"/>
  <arg name="debug_port_main" default="5678"/>
  <arg name="debug_port_passability" default="5679"/>
  <arg name="debug_port_traversal" default="5680"/>
  <arg name="debug_port_odom_bridge" default="5681"/>
  <arg name="frame_skip" default="0"/>
  <arg name="resize_scale" default="1.0"/>
  <arg name="loop" default="true"/>
  <arg name="enable_visualization_global" default="True" />
  <arg name="durations_file_path_global" default="/app/catkin_ws/src/robodog_glass_door_detection/scripts/durations" />
  <arg name="input_mode" default="bag" />  <!-- 'bag' or 'gazebo' -->
  <arg name="reference_door_distance_m" default="2.0" />

    <!-- Topics published by bag bridge -->
    <!--
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />
    -->
    <!-- Topics published by gazebo realsense camera -->
  <arg name="color_topic" default="/realsense/realsense/color/image_raw" />
  <arg name="depth_topic" default="/realsense/realsense/depth/image_raw" />
  <arg name="camera_info_topic" default="/realsense/realsense/color/camera_info" />
  <!--<include file="$(find robodog_glass_door_detection)/launch/go1_localization.launch"/>-->

  <!-- Start the realsense bag bridge (reads bag via librealsense + publishes aligned depth) -->
  <node pkg="robodog_glass_door_detection" type="realsense_bag_bridge.py" name="realsense_bag_bridge" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_realsense_bag_bridge')) + ' --wait-for-client' or '')">
    <param name="bag_file" value="$(arg bag_file)" />
    <param name="frame_skip" value="$(arg frame_skip)" />
    <param name="resize_scale" value="$(arg resize_scale)" />
    <param name="loop" value="$(arg loop)" />
    <param name="input_mode" value="$(arg input_mode)" />  <!-- 'bag' or 'gazebo' -->
    <!-- Make sure the bridge publishes the topics named below (see code) -->
    <param name="color_topic" value="$(eval arg('color_topic') + '_final')"/>
    <param name="depth_topic" value="$(eval arg('depth_topic') + '_final')"/>
    <param name="camera_info_topic" value="$(eval arg('camera_info_topic') + '_final')"/>

    
  </node>

    <!-- Start the realsense bag bridge (reads bag via librealsense + publishes aligned depth) -->
  <node pkg="robodog_glass_door_detection" type="odom_bridge.py" name="odom_bridge" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_odom_bridge')) + ' --wait-for-client' or '')">
    <rosparam>
      model_name : go1_gazebo
    </rosparam>
  </node>
  
  <node pkg="robodog_glass_door_detection" type="main.py" name="glass_door_detection" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_main')) + ' --wait-for-client' or '')">
    <param name="color_topic" value="$(eval arg('color_topic') + '_final')" />
    <param name="depth_topic" value="$(eval arg('depth_topic') + '_final')" />
    <param name="camera_info_topic" value="$(eval arg('camera_info_topic') + '_final')" />
    <param name="queue_size" value="30" />
    <param name="sync_slop" value="0.2" />
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_glass_door_detection.txt')"/>
    <param name="reference_door_distance_m" value="$(arg reference_door_distance_m)"/>
    <rosparam>
      plane_detector:  
        max_no_candidate_frames: 5
        max_inlier_density: 0.5
        global_map_distance_accuracy_to_door_plane : 0.4
        margin_for_glass_width_inaccuracy : 0.2
        backproject:
          subsample: 4
        filter_points:
          voxel_size: 0.008
          normal_radius: 0.03
          normal_max_nn: 30
          nx_thr: 0.30
          ny_thr: 0.30
          nz_min: 0.85
        ransac:
          distance_threshold: 0.03
          n: 3
          num_iterations: 100
          vertical_tol: 0.1
          min_inliers: 500
          max_planes: 2
        outline:
          lower_pct : 5
          upper_pct : 95
          min_width_m: 0.8
          min_height_m: 0.5
        temporal_smoothing:
          alpha: 0.3
          max_jump_deg: 8.0
          max_jump_m: 0.3
          window: 10
          confirm_k: 6
          drop_k: 2
        output:
          ransac_plane_distance : 2.0
          ransac_error : 0.1
    </rosparam>
    <rosparam>
      door_type_detector:
        bin_width: 0.04
        min_vertical_support: 0.4
        min_points_per_bin: 5
        min_glass_width: 0.16
        max_glass_width : 1.5
        num_vertical_slices: 40
        min_points_per_vertical_slice: 2
    </rosparam>

    <rosparam>
      color_image_based_door_detector:
        scale: 0.5
        canny:
          lower_factor: 0.7
          upper_factor: 2.0
        blur:
          ksize: 3
          sigma: 0.8
        hough:
          threshold: 100
          min_line_length: 100
          max_line_gap: 20
        angle_threshold: 0.2
        min_num_of_valid_depths_for_depth_estimation: 5
        extrapolation:
          gradient_threshold_for_extrapolation: 0.1
          window_size_for_extrapolation: 5
    </rosparam>
    <rosparam>
      depth_image_based_door_detector:
        PHYSICAL_GRADIENT_THRESHOLD: 0.25
        scale: 0.5
        hough:
          threshold: 100
          min_line_length: 100
          max_line_gap: 30
        bilateral:
          d: 5
          sigma_color: 50
          sigma_space: 75
        sobel:
          ksize: 3
        adaptive:
          k_factor: 1.0
          fallback_threshold: 0.1
        angle_threshold: 0.2
        roi_width_for_depth_estimation: 10
        merge_lines:
          x_threshold_to_merge_lines: 10
          MIN_LINE_LENGTH_after_merging: 50
    </rosparam>
    <rosparam>
      door_geometry:
        glass_width_cm: 40
        center_frame_width_cm: 30
        roi_width: 240
        correction_factor: 1.1
    </rosparam>
    <rosparam>
      door_status_detector:
        roi_width: 240
        margin: 10
        threshold: 0.01
    </rosparam>
  </node>
  <node pkg="robodog_glass_door_detection" type="passability_check_main.py" name="check_if_corridor_is_passable" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_passability')) + ' --wait-for-client' or '')">
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_passability_check.txt')"/>
     <param name="color_topic" value="$(eval arg('color_topic') + '_final')" />
    <param name="depth_topic" value="$(eval arg('depth_topic') + '_final')" />
    <param name="camera_info_topic" value="$(eval arg('camera_info_topic') + '_final')" />
    <rosparam>
      passabilility_check:
        back_proj_params:
          minimum_depth : 0.1  # meters
          maximum_depth_beyond_corridor_center_point : 1.5  # meters
          subsample: 4
          minimum_depth_local_passability_check : 0.05  # meters
          maximum_depth_local_passability_check : 0.5  # meters
        virtual_corridor_search:
          slide_step_x_direction: 0.1  # meters
        
        filter_points_params:
          ransac:
            max_planes: 3
            n: 3
            distance_threshold: 0.02
            num_iterations: 50
            min_inliers: 50
            horizontal_tol: 0.3
          normal_filter:
            radius: 0.15
            max_nn: 40
            ny_thr: 0.7
          outlier:
            nb_neighbors: 50
            std_ratio: 1.0
          cc_filter:
            near_z: 0.6
            min_area_near: 640
            minimum_area_far: 600
        traversal_params:
          min_corridor_clearance_beyond_door_to_trigger_traversal_node : 0.7  # meters. stil based on the length of robot. this is min distance beyond door plane to check for corridor passability. setting higher value cause detecting human as obstacle when the door is opening outward
          robot_width: 0.45  # meters ,robot  width
          robot_length : 0.7  # meters
          robot_height_above_camera_level : 0.5  # meters
          safety_margin_robot_width: 0.05  # meters
          door_frame_margin: 0.05  # meters
          minimum_depth_points_after_filtering : 10  # points
    </rosparam>
  </node>
  <node pkg="robodog_glass_door_detection" type="door_traversal_controller.py" name="door_traversal" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_traversal')) + ' --wait-for-client' or '')">
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_door_traversal.txt')"/>
    <rosparam>
      door_traversal_controller:
        control_rate_hz: 5
        min_front_clearance_local_passability_check: 0.2  # meters
        robot_length : 0.7  # meters


        passability_hysteresis:
          consecutive_passable_to_true: 5
          consecutive_unpassable_to_false: 4
        heading_error_estimation:
          heading_filter_alpha: 0.3
          heading_error_tolerance: 0.03
          min_forward_motion_for_heading : 0.02  # meters
          required_heading_samples : 2
        pre_align_heading_state:
          lateral_error_tolerance: 0.05 # meters
          omega_max: 0.4
          kp_lateral_movement: -1.2
        pre_align_readjust_heading_state:
          fraction_distance_to_corridor_mid_point_for_readjust_heading: 0.3  # fraction of distance to the mid of corridor
          omega_max: 0.4
          kp_lateral_movement: -1.2
        pre_align_position_state:
          lateral_error_tolerance: 0.05 # 
          velocity: 0.2 # m/s    # minimum of 5 cm/s forward to ensure some movement by controller
          omega_max: 0.4
          kp_lateral_movement: -1.2
        align_state:
          lateral_error_tolerance: 0.1 # half of the width of robot in meters 
          heading_error_tolerance: 0.02 # meters ( tigher than pre-align)
          omega_max: 0.5
          kp_heading_align_state : -1.2
        traverse_state:
          v_max: 0.2
          v_min: 0.06
          omega_max: 0.1
          k_clearance: 0.3
          kp_corridor_center: -1.5
          kd_corridor_center: 0.8


        move_after_crossing_corridor_midpoint_state:
          kp_heading_adjustment : -1.2
          velocity: 0.2  # m/s
          omega_max: 0.4   # rad/s
        abort:
          abort_backoff_distance: 0.25
          abort_backoff_speed: -0.08
    </rosparam>
  </node>
</launch>
