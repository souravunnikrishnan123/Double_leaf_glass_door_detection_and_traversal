<?xml version="1.0"?>
<model>
  <name>birdseye</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Static overhead camera that publishes a bird's-eye view as a ROS image
    topic, so it can be recorded into the same bag as the robot's own camera
    and merged without any clock guesswork.
  </description>
</model>
