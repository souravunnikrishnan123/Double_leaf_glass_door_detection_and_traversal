<launch>
  <!-- Remap these as needed to your camera topics -->
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />

  <node pkg="robodog_glass_door_detection" type="main.py" name="glass_door_detection" output="screen">
    <param name="color_topic" value="$(arg color_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="queue_size" value="30" />
    <param name="sync_slop" value="0.2" />
    <rosparam ns="color_image_based_door_detector">
      depth_range: [1.7, 2.3]
      scale: 0.5
      canny:
        lower_factor: 0.7
        upper_factor: 2.0
      blur:
        ksize: 3
        sigma: 0.8
      hough:
        threshold: 100
        min_line_length: 100
        max_line_gap: 20
      angle_threshold: 0.2
      min_num_of_valid_depths_for_depth_estimation: 5
      extrapolation:
        gradient_threshold_for_extrapolation: 0.1
        window_size_for_extrapolation: 5

      
    </rosparam>
    <rosparam ns="depth_image_based_door_detector">
      MIN_DEPTH: 1.0
      MAX_DEPTH: 4.0
      DEPTH_RANGE: [1.7, 2.3]
      PHYSICAL_GRADIENT_THRESHOLD: 0.25
      scale: 0.5
      hough:
        threshold: 100
        min_line_length: 100
        max_line_gap: 30
      bilateral:
        d: 5
        sigma_color: 50
        sigma_space: 75
      sobel:
        ksize: 3
      adaptive:
        k_factor: 2.0
        fallback_threshold: 0.1
      angle_threshold: 0.2
      roi_width_for_depth_estimation: 10
      merge_lines:
        x_threshold_to_merge_lines: 10
        MIN_LINE_LENGTH_after_merging: 50
    </rosparam>
    <rosparam ns="door_geometry">
      glass_width_cm: 40
      center_frame_width_cm: 30
      roi_width: 240
      min_depth: 1.7
      correction_factor: 1.1
    </rosparam>
  </node>
</launch>
