<launch>
  <!-- Remap these as needed to your camera topics -->
  <arg name="bag_file" default="/app/realsense_camera_feed/brown_door/brown_door_opening_inward_with_other_side_visible_but_with_lot_of_noise_night.bag"/>

  <!-- Debug toggle: run with debug:=true to enable VS Code attach -->
  <arg name="debug" default="false"/>
  <arg name="frame_skip" default="2"/>
  <arg name="resize_scale" default="1.0"/>
  <arg name="enable_visualization_global" default="True" />
  <arg name="durations_file_path_global" default="/app/catkin_ws/src/robodog_glass_door_detection/scripts/durations" />


    <!-- Topics published by bag bridge -->
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />



  <!-- Start the realsense bag bridge (reads bag via librealsense + publishes aligned depth) -->
  <node pkg="robodog_glass_door_detection" type="realsense_bag_bridge.py" name="realsense_bag_bridge" output="screen">
    <param name="bag" value="$(arg bag_file)" />
    <param name="frame_skip" value="$(arg frame_skip)" />
    <param name="resize_scale" value="$(arg resize_scale)" />
    <!-- Make sure the bridge publishes the topics named below (see code) -->
  </node>
  
  <node pkg="robodog_glass_door_detection" type="main.py" name="glass_door_detection" output="screen" launch-prefix="$(eval debug and 'python3 -m debugpy --listen 0.0.0.0:5678 --wait-for-client' or '')">
    <param name="color_topic" value="$(arg color_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="queue_size" value="30" />
    <param name="sync_slop" value="0.2" />
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_glass_door_detection.txt')"/>
    <rosparam>
      plane_detector:  
        max_no_candidate_frames: 5
        max_inlier_density: 0.5
        reference_door_distance_m : 2.0
        global_map_distance_accuracy_to_door_plane : 0.2
        margin_for_glass_width_inaccuracy : 0.2
        backproject:
          subsample: 4
        filter_points:
          voxel_size: 0.008
          normal_radius: 0.03
          normal_max_nn: 30
          nx_thr: 0.30
          ny_thr: 0.30
          nz_min: 0.85
        ransac:
          distance_threshold: 0.03
          n: 3
          num_iterations: 100
          vertical_tol: 0.1
          min_inliers: 500
          max_planes: 2
        outline:
          lower_pct : 5
          upper_pct : 95
          min_width_m: 0.8
          min_height_m: 0.5
        temporal_smoothing:
          alpha: 0.3
          max_jump_deg: 8.0
          max_jump_m: 0.3
          window: 10
          confirm_k: 6
          drop_k: 2
        output:
          ransac_plane_distance : 2.0
          ransac_error : 0.1
    </rosparam>
    <rosparam>
      door_type_detector:
        bin_width: 0.04
        min_vertical_support: 0.4
        min_points_per_bin: 5
        min_glass_width: 0.16
        max_glass_width : 1.5
        num_vertical_slices: 40
        min_points_per_vertical_slice: 2
    </rosparam>

    <rosparam>
      color_image_based_door_detector:
        scale: 0.5
        canny:
          lower_factor: 0.7
          upper_factor: 2.0
        blur:
          ksize: 3
          sigma: 0.8
        hough:
          threshold: 100
          min_line_length: 100
          max_line_gap: 20
        angle_threshold: 0.2
        min_num_of_valid_depths_for_depth_estimation: 5
        extrapolation:
          gradient_threshold_for_extrapolation: 0.1
          window_size_for_extrapolation: 5
    </rosparam>
    <rosparam>
      depth_image_based_door_detector:
        PHYSICAL_GRADIENT_THRESHOLD: 0.25
        scale: 0.5
        hough:
          threshold: 100
          min_line_length: 100
          max_line_gap: 30
        bilateral:
          d: 5
          sigma_color: 50
          sigma_space: 75
        sobel:
          ksize: 3
        adaptive:
          k_factor: 1.0
          fallback_threshold: 0.1
        angle_threshold: 0.2
        roi_width_for_depth_estimation: 10
        merge_lines:
          x_threshold_to_merge_lines: 10
          MIN_LINE_LENGTH_after_merging: 50
    </rosparam>
    <rosparam>
      door_geometry:
        glass_width_cm: 40
        center_frame_width_cm: 30
        roi_width: 240
        correction_factor: 1.1
    </rosparam>
    <rosparam>
      door_status_detector:
        roi_width: 240
        margin: 10
        threshold: 0.05
    </rosparam>
  </node>
  <node pkg="robodog_glass_door_detection" type="passability_check_main.py" name="check_if_corridor_is_passable" output="screen" launch-prefix="$(eval debug and 'python3 -m debugpy --listen 0.0.0.0:5678 --wait-for-client' or '')">
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_passability_check.txt')"/>
    <rosparam>
      passabilility_check:
        back_proj_params:
          minimum_depth : 0.05  # meters
          maximum_depth_beyond_door_depth : 1.5  # meters
          subsample: 4
        filter_points_params:
          ransac:
            max_planes: 3
            n: 3
            distance_threshold: 0.02
            num_iterations: 50
            min_inliers: 50
            horizontal_tol: 0.3
          normal_filter:
            radius: 0.15
            max_nn: 40
            ny_thr: 0.7
          outlier:
            nb_neighbors: 50
            std_ratio: 1.0
          cc_filter:
            near_z: 0.6
            min_area_near: 640
            minimum_area_far: 600
            base_area_at_1m: 1400
            min_z: 0.1
            max_z: 4.0
        traversal_params:
          min_front_clearance: 3.0  # meters
          robot_width: 0.45  # meters ,robot  width
          safety_margin_robot_width: 0.05  # meters
          door_frame_margin: 0.05  # meters
          minimum_depth_points_after_back_projection : 50  # points
          max_obstacle_height : -0.5  # meters
          minimum_depth_points_after_filtering : 10  # points
    </rosparam>
  </node>
  <node pkg="robodog_glass_door_detection" type="door_traversal_controller.py" name="door_traversal" output="screen" launch-prefix="$(eval debug and 'python3 -m debugpy --listen 0.0.0.0:5678 --wait-for-client' or '')">
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_door_traversal.txt')"/>
    <rosparam>
      door_traversal_controller:
        control_rate_hz: 5
        required_consecutive_safe : 3
        pre_align_state:
          lateral_error_tolerance: 0.05 # meters
          velocity: 0.03 # m/s
          omega_max: 0.4
          kp_lateral_movement: -1.2
        align_state:
          lateral_error_tolerance: 0.02 # meters ( tigher than pre-align)
          velocity: 0.02 # m/s
          omega_max: 0.5
          kp_lateral_movement: -1.8
        traverse_state:
          distance_threshold: 1.0
          v_max: 0.2
          v_min: 0.05
          omega_max: 0.6
          k_clearance: 0.3
          kp_corridor_center: 1.5
          scale_factor: 0.1
        abort:
          abort_backoff_distance: 0.25
          abort_backoff_speed: -0.08
    </rosparam>
  </node>
</launch>
