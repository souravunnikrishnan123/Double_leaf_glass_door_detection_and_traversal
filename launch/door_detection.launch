<launch>
  <!-- This launch file wires the complete chain: RGB-D normalization, odometry
       bridging, door detection, corridor clearance, and finally the traversal
       controller, plus optional saving of the debug images. -->
  <!-- RealSense recording played by the bridge when input_mode is 'bag' -->
  <arg name="bag_file" default="/app/realsense_camera_feed/brown_door_with_plywood/gazebo.bag"/>

  <!-- Debug toggle: run with debug:=true to enable VS Code attach -->
  <arg name="debug" default="false"/>
  <!-- Unique debug ports per node to avoid conflicts -->
  <arg name="debug_port_realsense_bag_bridge" default="5677"/>
  <arg name="debug_port_main" default="5678"/>
  <arg name="debug_port_passability" default="5679"/>
  <arg name="debug_port_traversal" default="5680"/>
  <arg name="debug_port_odom_bridge" default="5681"/>
  <!-- Bag mode only: after each published frame set, skip this many -->
  <arg name="frame_skip" default="2"/>
  <!-- Output image scale. Pixel-domain parameters below stay written for 1.0;
       each node converts them to the published resolution. -->
  <arg name="resize_scale" default="1.0"/>
  <!-- Bag mode only: repeat playback when the bag ends -->
  <arg name="loop" default="true"/>
  <arg name="enable_visualization_global" default="true" />
  <arg name="durations_file_path_global" default="/app/catkin_ws/src/robodog_glass_door_detection/scripts/durations" />
  <arg name="input_mode" default="bag" />  <!-- 'bag' or 'gazebo' -->
  <arg name="reference_door_distance_m" default="2.0" />
  <arg name="profiling_enabled" default="false" />
  <arg name="enable_result_log" default="false" />
  <arg name="result_log_path_global" default="/app/catkin_ws/src/robodog_glass_door_detection/scripts" />
  <arg name="profiler_output_path" default="/app/catkin_ws/src/robodog_glass_door_detection/scripts/door_detection_profile_python.html" />
  <!-- Visualization image saving: every launch writes to a new run folder,
       <results_root>/<folder>/run<N>/<file name prefix>NNNN.png, with the prefixes
       listed on the image_recorder node below. <folder> is the bag file name without
       .bag in bag mode, and gazebo_results_folder in gazebo mode. -->
  <arg name="save_images" default="true" />
  <!-- Save only frames with lines, ROIs or text drawn on them (the <topic>/annotated twins).
       The normal topics still carry every frame for rqt_image_view. -->
  <arg name="save_only_annotated" default="true" />
  <arg name="saved_topic_suffix" value="$(eval '/annotated' if str(arg('save_only_annotated')).lower() == 'true' else '')" />
  <!-- Gazebo only: next to every saved passability_viewNNNN.png, also save the overhead
       camera frame from the same instant (closest header stamp) as birdseyeNNNN.png.
       The camera is the university_world birdseye model spawned by unitree_gazebo normal.launch. -->
  <arg name="save_birdseye" default="true" />
  <arg name="birdseye_topic" default="/birdseye/image_raw" />
  <arg name="record_birdseye" value="$(eval arg('input_mode') == 'gazebo' and str(arg('save_birdseye')).lower() == 'true')" />
  <arg name="results_root" default="/app/catkin_ws/src/results" />
  <arg name="bag_name" default="$(eval arg('bag_file').split('/')[-1].rsplit('.', 1)[0])" />
  <!-- Gazebo has no bag file to name the folder after, so give it here -->
  <arg name="gazebo_results_folder" default="gazebo_simulation" />
  <arg name="results_dir" default="$(eval arg('results_root') + '/' + (arg('bag_name') if arg('input_mode') == 'bag' else arg('gazebo_results_folder')))" />
  <!-- Topic base names chosen by input mode -->
  <!-- _final is appended to these names to form the bridge's output topics.
       Every downstream node subscribes to that normalized output, independent
       of bag/Gazebo mode. In gazebo mode the bridge reads the simulator's
       /realsense/realsense/... image topics directly. -->
  <arg name="color_topic"
      default="$(eval '/camera/color/image_raw' if arg('input_mode') == 'bag' else '/realsense/realsense/color/image_raw')" />

  <arg name="depth_topic"
      default="$(eval '/camera/aligned_depth_to_color/image_raw' if arg('input_mode') == 'bag' else '/realsense/realsense/depth/image_raw')" />

  <arg name="camera_info_topic"
      default="$(eval '/camera/color/camera_info' if arg('input_mode') == 'bag' else '/realsense/realsense/color/camera_info')" />

  <!-- Static camera TF is required only for bag playback -->
  <group if="$(eval arg('input_mode') == 'bag')">

      <!-- Same optical-frame rotation as the Go1 model's realsense_d455_optical_joint
           (rpy -1.5708 0 -1.5708): the optical frame is x right, y down, z forward,
           while trunk is x forward, y left, z up. -->
      <node pkg="tf2_ros"
            type="static_transform_publisher"
            name="camera_static_tf"
            args="0.279 0.013 0.080 -0.5 0.5 -0.5 0.5 trunk realsense_d455_optical_frame" />

  </group>


  <!--<include file="$(find robodog_glass_door_detection)/launch/go1_localization.launch"/>-->

  <!-- Start the RGB-D bridge: in bag mode it reads the bag via librealsense and
       publishes depth aligned to color; in gazebo mode it republishes the
       simulated camera. Both modes publish on the _final topics. -->
  <node pkg="robodog_glass_door_detection" type="realsense_bag_bridge.py" name="realsense_bag_bridge" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_realsense_bag_bridge')) + ' --wait-for-client' or '')">
    <param name="bag_file" value="$(arg bag_file)" />
    <param name="frame_skip" value="$(arg frame_skip)" />
    <param name="resize_scale" value="$(arg resize_scale)" />
    <param name="loop" value="$(arg loop)" />
    <param name="input_mode" value="$(arg input_mode)" />  <!-- 'bag' or 'gazebo' -->
    <!-- Output topics; the bridge publishes exactly these names -->
    <param name="color_topic" value="$(eval arg('color_topic') + '_final')"/>
    <param name="depth_topic" value="$(eval arg('depth_topic') + '_final')"/>
    <param name="camera_info_topic" value="$(eval arg('camera_info_topic') + '_final')"/>
    <param name="profiling_enabled" value="$(arg profiling_enabled)"/>
    <param name="profiler_output_path" value="$(arg profiler_output_path)"/>
    <param name="enable_result_log" value="$(arg enable_result_log)"/>
    <param name="result_log_path" value="$(eval arg('result_log_path_global'))"/>
  </node>


  <!-- Start the odometry bridge: republishes the Gazebo model pose as
       /odom_bridge_output for the passability and traversal nodes -->
  <node pkg="robodog_glass_door_detection" type="odom_bridge.py" name="odom_bridge" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_odom_bridge')) + ' --wait-for-client' or '')">
    <!-- In bag mode there is no Gazebo, so the bridge publishes a fixed pose at the origin instead -->
    <param name="input_mode" value="$(arg input_mode)" />
    <rosparam>
      model_name : go1_gazebo
    </rosparam>
  </node>
  
  <node pkg="robodog_glass_door_detection" type="main.py" name="glass_door_detection" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_main')) + ' --wait-for-client' or '')">
    <!-- Approximate synchronization tolerates the small timestamp skew present
         in simulated streams while still presenting paired RGB-D frames. -->
    <param name="color_topic" value="$(eval arg('color_topic') + '_final')" />
    <param name="depth_topic" value="$(eval arg('depth_topic') + '_final')" />
    <param name="camera_info_topic" value="$(eval arg('camera_info_topic') + '_final')" />
    <!-- Pixel-domain parameters in this file are written for resize_scale=1.
         Each node converts them to the resolution actually being published. -->
    <param name="resize_scale" value="$(arg resize_scale)" />
    <param name="queue_size" value="2" />
    <param name="sync_slop" value="0.2" />
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_glass_door_detection.txt')"/>
    <param name="reference_door_distance_m" value="$(arg reference_door_distance_m)"/>
    <param name="profiling_enabled" value="$(arg profiling_enabled)"/>
    <param name="profiler_output_path" value="$(arg profiler_output_path)"/>
    <param name="enable_result_log" value="$(arg enable_result_log)"/>
    <param name="result_log_path" value="$(eval arg('result_log_path_global'))"/>
    <rosparam>
      plane_detector:  
        max_no_candidate_frames: 5  # consecutive frames without any plane candidate before the full-image fallback
        global_map_distance_accuracy_to_door_plane : 0.4
        margin_for_glass_width_inaccuracy : 0.2
        backproject:
          subsample: 4
        filter_points:
          voxel_size: 0.008
          normal_radius: 0.03
          normal_max_nn: 30
          nx_thr: 0.30
          ny_thr: 0.30
          nz_min: 0.85
        ransac:
          distance_threshold: 0.03
          n: 3
          num_iterations: 100
          vertical_tol: 0.1
          min_inliers: 500
          max_planes: 2
        outline:
          lower_pct : 5
          upper_pct : 95
          min_width_m: 0.8
          min_height_m: 0.5
        temporal_smoothing:
          alpha: 0.3
          max_jump_deg: 8.0
          max_jump_m: 0.3
          window: 10
          confirm_k: 6
          drop_k: 2
        output:
          ransac_plane_distance : 2.0  # meters. initial value only; plane search refines it at runtime
          ransac_error : 0.1  # fractional depth band around the plane distance used to accept frame lines
    </rosparam>
    <rosparam>
      door_type_detector:
        bin_width: 0.04
        min_vertical_support: 0.4
        min_points_per_bin: 5
        min_glass_width: 0.16
        max_glass_width : 1.5
        num_vertical_slices: 40
        min_points_per_vertical_slice: 2
    </rosparam>

    <rosparam>
      color_image_based_door_detector:
        scale: 0.5
        canny:
          lower_factor: 0.7
          upper_factor: 2.0
        blur:
          ksize: 3
          sigma: 0.8
        hough:
          threshold: 100
          min_line_length: 100
          max_line_gap: 20
        angle_threshold: 0.2
        min_num_of_valid_depths_for_depth_estimation: 5
    </rosparam>
    <rosparam>
      depth_image_based_door_detector:
        PHYSICAL_GRADIENT_THRESHOLD: 0.25
        scale: 0.5
        hough:
          threshold: 100
          min_line_length: 100
          max_line_gap: 30
        bilateral:
          d: 5
          sigma_color: 50
          sigma_space: 75
        sobel:
          ksize: 3
        adaptive:
          k_factor: 1.0
          fallback_threshold: 0.1
        angle_threshold: 0.2
        roi_width_for_depth_estimation: 10
        merge_lines:
          x_threshold_to_merge_lines: 10
          MIN_LINE_LENGTH_after_merging: 50
    </rosparam>
    <rosparam>
      door_geometry:
        glass_width_cm: 40
        center_frame_width_cm: 30
        roi_width: 240
        correction_factor: 1.1
    </rosparam>
    <rosparam>
      door_status_detector:
        margin: 10
        threshold: 0.01
        roi_subsample: 4
      maximum_allowed_number_of_times_no_frame_detected_as_smoothed_door_state: 20
    </rosparam>
  </node>
  <node pkg="robodog_glass_door_detection" type="passability_check_main.py" name="check_if_passable" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_passability')) + ' --wait-for-client' or '')">
    <!-- Pixel-domain parameters in this file are written for resize_scale=1.
         Each node converts them to the resolution actually being published. -->
    <param name="resize_scale" value="$(arg resize_scale)" />
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_passability_check.txt')"/>
     <param name="color_topic" value="$(eval arg('color_topic') + '_final')" />
    <param name="depth_topic" value="$(eval arg('depth_topic') + '_final')" />
    <param name="camera_info_topic" value="$(eval arg('camera_info_topic') + '_final')" />
    <param name="profiling_enabled" value="$(arg profiling_enabled)"/>
    <param name="profiler_output_path" value="$(arg profiler_output_path)"/>
    <param name="enable_result_log" value="$(arg enable_result_log)"/>
    <param name="result_log_path" value="$(eval arg('result_log_path_global'))"/>
    <rosparam>
      <!-- This spelling is historical and must match the namespace used in the Python node. -->
      passabilility_check:
        back_proj_params:
          minimum_depth : 0.1  # meters
          maximum_depth_beyond_corridor_center_point : 1.5  # meters
          subsample: 4
          minimum_depth_local_passability_check : 0.05  # meters.
          maximum_depth_local_passability_check : 1.0  # meters
        virtual_corridor_search:
          slide_step_x_direction: 0.1  # meters
        
        filter_points_params:
          ransac:
            max_planes: 3
            n: 3
            distance_threshold: 0.02
            num_iterations: 50
            min_inliers: 50
            horizontal_tol: 0.3
          normal_filter:
            radius: 0.15
            max_nn: 40
            ny_thr: 0.7
          outlier:
            nb_neighbors: 50
            std_ratio: 1.0
          cc_filter:
            near_z: 0.6
            min_area_near: 640
            minimum_area_far: 600
        traversal_params:
          min_corridor_clearance_beyond_door_to_trigger_traversal_node : 0.7  # meters. stil based on the length of robot. this is min distance beyond door plane to check for corridor passability. setting higher value cause detecting human as obstacle when the door is opening outward
          robot_width: 0.45  # meters ,robot  width
          robot_length : 0.7  # meters
          robot_height_above_camera_level : 0.5  # meters
          safety_margin_robot_width: 0.05  # meters
          minimum_depth_points_after_filtering : 10  # points
    </rosparam>
  </node>
  <node pkg="robodog_glass_door_detection" type="door_traversal_controller.py" name="door_traversal" output="screen" launch-prefix="$(eval str(arg('debug')).lower() == 'true' and 'python3 -m debugpy --listen 0.0.0.0:' + str(arg('debug_port_traversal')) + ' --wait-for-client' or '')">
    <param name="enable_visualization" value="$(arg enable_visualization_global)" />
    <param name="durations_file_path" value="$(eval arg('durations_file_path_global') + '_door_traversal.txt')"/>
    <param name="enable_result_log" value="$(arg enable_result_log)"/>
    <param name="result_log_path" value="$(eval arg('result_log_path_global'))"/>
    <param name="profiling_enabled" value="$(arg profiling_enabled)"/>
    <param name="profiler_output_path" value="$(arg profiler_output_path)"/>
    <rosparam>
      door_traversal_controller:
        control_rate_hz: 5
        min_front_clearance_local_passability_check: 0.6  # meters. this limit is set because, gazebo mode, min depth available is 0.4m
        robot_length : 0.7  # meters
        gazebo_service_timeout : 5.0
        passability_hysteresis:
          consecutive_passable_to_true: 5
          consecutive_unpassable_to_false: 4
        heading_error_estimation:
          heading_filter_alpha: 0.3
          heading_error_tolerance: 0.03
          min_forward_motion_for_heading : 0.02  # meters
          required_heading_samples : 2
        pre_align_heading_state:
          lateral_error_tolerance: 0.05 # meters
          omega_max: 0.4
          kp_lateral_movement: -1.2
        pre_align_readjust_heading_state:
          fraction_distance_to_corridor_mid_point_for_readjust_heading: 0.3  # fraction of distance to the mid of corridor
          omega_max: 0.4
          kp_lateral_movement: 1.2
        pre_align_position_state:
          lateral_error_tolerance: 0.05 # 
          velocity: 0.2 # m/s    # minimum of 5 cm/s forward to ensure some movement by controller
          omega_max: 0.4
          kp_lateral_movement: -1.2
        align_state:
          lateral_error_tolerance: 0.1 # half of the width of robot in meters 
          heading_error_tolerance: 0.02 # rad ( tigher than pre-align)
          omega_max: 0.5
          kp_heading_align_state : 1.2
        traverse_state:
          v_max: 0.2
          v_min: 0.06
          omega_max: 0.1
          k_clearance: 0.3
          kp_corridor_center: -1.5
          kp_heading : -0.8
          kd_corridor_center: 0.8
        move_after_crossing_corridor_midpoint_state:
          kp_heading_adjustment : -1.2
          velocity: 0.02  # m/s
          omega_max: 0.4   # rad/s
        abort:
          abort_backoff_distance: 0.25
          abort_backoff_speed: -0.08
    </rosparam>
  </node>

  <!-- Save visualization frames to disk (disable with save_images:=false) -->
  <node if="$(arg save_images)" pkg="robodog_glass_door_detection" type="image_recorder.py" name="image_recorder" output="screen" clear_params="true">
    <param name="results_dir" value="$(arg results_dir)" />
    <!-- file name prefix : topic -->
    <param name="topics/passability_view" value="/check_if_passable/passability_view$(arg saved_topic_suffix)" />
    <param name="topics/color_branch_color_image" value="/glass_door_detection/viz/color_branch_color_image$(arg saved_topic_suffix)" />
    <param name="topics/depth_branch_color_image" value="/glass_door_detection/viz/depth_branch_color_image$(arg saved_topic_suffix)" />
    <param name="topics/color_branch" value="/glass_door_detection/viz/color_branch$(arg saved_topic_suffix)" />
    <param name="topics/depth_branch" value="/glass_door_detection/viz/depth_branch$(arg saved_topic_suffix)" />
    <param name="topics/plane_overlay" value="/glass_door_detection/viz/plane_overlay$(arg saved_topic_suffix)" />
    <!-- file name prefix : topic saved only next to the "with" prefix, with the same NNNN -->
    <param if="$(arg record_birdseye)" name="paired/birdseye/topic" value="$(arg birdseye_topic)" />
    <param if="$(arg record_birdseye)" name="paired/birdseye/with" value="passability_view" />
  </node>
</launch>
