<sdf version="1.6">
  <!-- This compact model isolates frame geometry and hinge motion for tests that
       do not need the full corridor world. -->
  <model name="glass_door_frame">
    <static>false</static>

    <!-- FIXED PANEL FRAME -->
    <link name="fixed_frame">
      <pose>-0.55 0 1.1 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
        </material>
      </visual>
    </link>

    <!-- MOVING PANEL FRAME -->
    <link name="moving_frame">
      <pose>0.55 0 1.1 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
        </material>
      </visual>
    </link>

    <!-- TOP FRAME -->
    <link name="top_frame">
      <pose>0 0 2.15 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box><size>1.3 0.1 0.1</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>1.3 0.1 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
        </material>
      </visual>
    </link>

    <!-- The moving upright rotates about world Z, matching a conventional door hinge. -->
    <!-- HINGE JOINT -->
    <joint name="door_hinge" type="revolute">
      <parent>fixed_frame</parent>
      <child>moving_frame</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.57</upper> <!-- 90 degrees -->
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
